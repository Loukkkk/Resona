<Application
    x:Class="Resona.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Valeurs de depart : seront mutees en place au demarrage par
                 App.xaml.cs (ApplyThemeResources) selon le theme choisi. On
                 mute les objets existants (pas de remplacement de cle) pour que
                 tous les controles qui y font reference se mettent a jour en
                 direct, sans avoir a recreer la fenetre. -->
            <Color x:Key="SystemAccentColor">#FF7C5CFF</Color>
            <Color x:Key="SystemAccentColorLight1">#FF9580FF</Color>
            <Color x:Key="SystemAccentColorLight2">#FFB3A3FF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFD1C7FF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF6347E0</Color>
            <Color x:Key="SystemAccentColorDark2">#FF4F36C2</Color>
            <Color x:Key="SystemAccentColorDark3">#FF3B27A3</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource SystemAccentColorLight1}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource SystemAccentColorLight2}" />

            <SolidColorBrush x:Key="AppAccentBrush" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="AppAccentSecondaryBrush" Color="#FFFF5CA8" />
            <!-- Couleur du texte/icône placé SUR un fond accent (bouton play/pause, etc.)
                 Muté par ApplyThemeResources : blanc si accent sombre, noir si accent clair -->
            <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="#FFFFFFFF" />
            <!-- Texte du player (timecodes, nom/artiste) : toujours blanc car le fond player est toujours sombre -->
            <SolidColorBrush x:Key="AppPlayerTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AppDeepBackgroundBrush" Color="#FF0E0B1A" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF1A1530" />
            <LinearGradientBrush x:Key="AppAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF7C5CFF" Offset="0" />
                <GradientStop Color="#FFFF5CA8" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="CardStyle" TargetType="Grid">
                <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Brushes spécifiques pour les contrôles -->
            <!-- Controles (boutons, listes deroulantes, popups) : look FIXE, independant du theme.
                 Ces brushes ne sont JAMAIS mutes par ApplyThemeResources : texte blanc sur fond sombre. -->
            <SolidColorBrush x:Key="AppControlForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AppPopupItemDisabledForegroundBrush" Color="#66FFFFFF" />

            <!-- Popups : menus, listes deroulantes, boites de dialogue -->
            <StaticResource x:Key="ContentDialogForeground" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemForegroundDisabled" ResourceKey="AppPopupItemDisabledForegroundBrush" />
            <StaticResource x:Key="ToggleMenuFlyoutItemForeground" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="ToggleMenuFlyoutItemForegroundPointerOver" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="ToggleMenuFlyoutItemForegroundPressed" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="ToggleMenuFlyoutItemForegroundDisabled" ResourceKey="AppPopupItemDisabledForegroundBrush" />
            <StaticResource x:Key="ToggleMenuFlyoutItemCheckGlyphForeground" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="ToggleMenuFlyoutItemCheckGlyphForegroundPointerOver" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="ToggleMenuFlyoutItemCheckGlyphForegroundPressed" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemForeground" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemForegroundPointerOver" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemForegroundPressed" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemForegroundSubMenuOpened" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundPressed" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="AppControlForegroundBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="AppControlForegroundBrush" />

            <SolidColorBrush x:Key="ToggleSwitchForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="RadioButtonForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxForegroundSelected" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextBoxForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextBoxForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextBoxForegroundPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextBoxForegroundDisabled" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextBoxForegroundSelected" Color="#FFFFFFFF" />
            <!-- Vraies cles WinUI du texte saisi (mutees par ApplyThemeResources) : evitent le texte noir
                 pendant la saisie (etat Focused) dans les champs de recherche. -->
            <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextBoxBackground" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="TextBoxBackgroundPointerOver" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="TextBoxBackgroundFocused" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="TextBoxBorderBrushPointerOver" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="TextBoxBorderBrushFocused" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackground" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchHeaderForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchOnForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchOffForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphForeground" Color="#FFFFFFFF" />

            <!-- Etats PointerOver/Pressed des controles COCHES/ACTIVES (ToggleSwitch "on",
                 CheckBox/RadioButton coches). Declares ici (pas crees dynamiquement en C#)
                 pour que le premier rendu de chaque controle les capture via ThemeResource :
                 ApplyThemeResources peut ensuite les MUTER comme les autres brushes, ce qui
                 les propage instantanement, y compris lors d'un changement DEPUIS/VERS le
                 theme blanc pur (contrairement a des cles ajoutees/retirees dynamiquement,
                 qui ne sont jamais relues par un template deja resolu). -->
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#FFFFFFFF" />

            <!-- Couleur AU REPOS des controles actives (mutee par ApplyThemeResources) -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF7C5CFF" />
            <!-- ToggleSwitch DESACTIVE : declares ici pour que ApplyThemeResources mute les instances
                 (sinon, en theme blanc, le rail restait invisible et seul le rond se voyait) -->
            <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#5CFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#87FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#FF7C5CFF" />

            <!-- Brushes de texte / contrôle MUTABLES.
                 Ils SURECRIVENT les clés WinUI du même nom : tous les contrôles
                 TextBlock/Button/etc. qui référencent {ThemeResource TextFillColor...}
                 pointeront vers NOS objets. ApplyThemeResources mute ensuite leur
                 .Color (jamais de remplacement) → la propage instantanément partout,
                 y compris pour les thèmes clairs (blanc) où le texte doit devenir
                 sombre. Sans ça, le thème blanc est illisible (texte blanc sur fond blanc). -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C8FFFFFF" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#A0FFFFFF" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5CFFFFFF" />
            <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00FFFFFF" />

            <!-- Brush de fond des éléments de NavigationView (sélection/survol) → muté aussi -->
            <SolidColorBrush x:Key="NavigationViewItemBackground" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFFFF" />


            <!-- Brushes pour le thumb et la piste des sliders (mises à jour par ApplyThemeResources) -->
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FF9580FF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFB3A3FF" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF7C5CFF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF9580FF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFB3A3FF" />

            <!-- Brushes des boutons standards (mutés pour thème clair/sombre) -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#28FFFFFF" />
            <!-- Survol/pression des boutons icones transparents (coeur des listes, boutons du player) :
                 teinte translucide mutee par ApplyThemeResources. Evite le flash blanc au debut du survol
                 en theme blanc (transition depuis le transparent blanc vers un gris opaque). -->
            <SolidColorBrush x:Key="PlayerButtonBackgroundPointerOver" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="PlayerButtonBackgroundPressed" Color="#0FFFFFFF" />

            <!-- Style de bouton utilise UNIQUEMENT en theme blanc pur (applique en code par la
                 page Parametres) : fond gris clair + bordure visibles, survol/pression avec des
                 couleurs fixes et sans transition, donc pas de flash blanc au survol. -->
            <SolidColorBrush x:Key="PureWhiteButtonBackground" Color="#FFE6E6E6" />
            <SolidColorBrush x:Key="PureWhiteButtonBackgroundHover" Color="#FFD6D6D6" />
            <SolidColorBrush x:Key="PureWhiteButtonBackgroundPressed" Color="#FFC6C6C6" />
            <SolidColorBrush x:Key="PureWhiteButtonBorder" Color="#FFB4B4B4" />
            <SolidColorBrush x:Key="PureWhiteButtonForeground" Color="#FF1A1A1A" />
            <Style x:Key="PureWhiteButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PureWhiteButtonBackground}" />
                <Setter Property="Foreground" Value="{StaticResource PureWhiteButtonForeground}" />
                <Setter Property="BorderBrush" Value="{StaticResource PureWhiteButtonBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,5,12,6" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{StaticResource PureWhiteButtonBackgroundHover}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{StaticResource PureWhiteButtonBackgroundPressed}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Meme rendu que PureWhiteButtonStyle, pour le DropDownButton (selecteur de langue) :
                 fleche et texte restent sombres, le fond ne disparait pas au survol. -->
            <Style x:Key="PureWhiteDropDownButtonStyle" TargetType="DropDownButton">
                <Setter Property="Background" Value="{StaticResource PureWhiteButtonBackground}" />
                <Setter Property="Foreground" Value="{StaticResource PureWhiteButtonForeground}" />
                <Setter Property="BorderBrush" Value="{StaticResource PureWhiteButtonBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,5,12,6" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DropDownButton">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid Padding="{TemplateBinding Padding}" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Foreground="{StaticResource PureWhiteButtonForeground}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    <FontIcon x:Name="ChevronIcon" Grid.Column="1" Glyph="&#xE70D;" FontSize="8"
                                              VerticalAlignment="Center"
                                              Foreground="{StaticResource PureWhiteButtonForeground}" />
                                </Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{StaticResource PureWhiteButtonBackgroundHover}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{StaticResource PureWhiteButtonBackgroundPressed}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Selecteur de langue dans les themes AUTRES que blanc pur : meme rendu que le style
                 par defaut, mais avec un survol/pression qui reste visible (les brosses sont mutees
                 par ApplyThemeResources). -->
            <SolidColorBrush x:Key="LanguageButtonHoverBrush" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="LanguageButtonPressedBrush" Color="#12FFFFFF" />
            <Style x:Key="ThemedDropDownButtonStyle" TargetType="DropDownButton">
                <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource ButtonBorderThemeThickness}" />
                <Setter Property="Padding" Value="12,5,12,6" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DropDownButton">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid Padding="{TemplateBinding Padding}" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    <FontIcon x:Name="ChevronIcon" Grid.Column="1" Glyph="&#xE70D;" FontSize="8"
                                              VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource LanguageButtonHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource LanguageButtonPressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="UseLayoutRounding" Value="False" />
            </Style>

            <!-- Style global pour centrer les ContentDialog -->
            <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="TitleTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
