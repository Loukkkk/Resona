<Page
    NavigationCacheMode="Required"
    Background="Transparent"
    x:Class="Resona.Views.ArtistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Resona.Models">

    <Grid Padding="24,44,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête : titre, puis barre d'outils sous le titre -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" UseLayoutRounding="False">
                <TextBlock Text="{x:Bind models:Strings.Current.ArtistsPage_Text_Artistes, Mode=OneWay}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="CountHint" FontSize="14" VerticalAlignment="Center" Margin="0,8,0,0" Text=" "
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- 1. Recherche -->
                <TextBox x:Name="SearchBox"
                         PlaceholderText="{x:Bind models:Strings.Current.ArtistsPage_Text_Rechercher, Mode=OneWay}" Width="220" MinHeight="28" Height="28" VerticalContentAlignment="Center" Padding="12,2,12,0"
                         TextChanged="SearchBox_TextChanged"
                         Foreground="{StaticResource TextBoxForegroundBrush}"
                         PlaceholderForeground="{ThemeResource TextFillColorTertiaryBrush}" />

                <!-- 2. Aléatoire -->
                <Button VerticalAlignment="Center" Click="ShuffleAll_Click" Height="28" Padding="12,0"
                        ToolTipService.ToolTip="{x:Bind models:Strings.Current.LibraryPage_ToolTipService_ToolTip_LectureAlatoire, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderThickness="1" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B1;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind models:Strings.Current.LibraryPage_Text_Alatoire, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 3. Tris -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind models:Strings.Current.LibraryPage_ToolTipService_ToolTip_Trierlaliste, Mode=OneWay}"
                            BorderThickness="1" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" Height="28" Padding="12,0,12,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8CB;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="SortButtonLabel" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,0" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="{x:Bind models:Strings.Current.PlaylistsPage_Sort_Name, Mode=OneWay}" Click="SortArtistsMenu_Click" Tag="name" />
                                <MenuFlyoutItem Text="{x:Bind models:Strings.Current.PlaylistsPage_Sort_Count, Mode=OneWay}" Click="SortArtistsMenu_Click" Tag="count" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="SortDirectionIconBtn" Height="28" Width="28" Padding="0" Click="SortDirection_Click" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                        <FontIcon x:Name="SortDirectionIcon" Glyph="&#xE74B;" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                </StackPanel>

                <!-- 4. Nombre de cartes -->
                <ComboBox x:Name="DisplayCountCombo" VerticalAlignment="Center" Height="28" MinHeight="28" Padding="12,0,0,0"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1"
                          BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                          Background="{ThemeResource ControlFillColorSecondaryBrush}" />

                <!-- Nettoyage IA (visible seulement si l'IA est activée) -->
                <Button x:Name="AICleanupBtn" Click="AICleanupBtn_Click" Visibility="Collapsed" VerticalAlignment="Center" Height="28" Padding="12,0"
                        CornerRadius="4" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE904;" FontSize="14" />
                        <TextBlock Text="{x:Bind models:Strings.Current.ArtistsPage_Text_NettoyageIA, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Grille artistes -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <VariableSizedWrapGrid x:Name="ArtistsGrid"
                               Orientation="Horizontal"
                               HorizontalAlignment="Left"
                               MaximumRowsOrColumns="99"
                               ItemWidth="220"
                               ItemHeight="210"
                               Margin="0,0,0,24" >
                <VariableSizedWrapGrid.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                        <AddDeleteThemeTransition />
                    </TransitionCollection>
                </VariableSizedWrapGrid.ChildrenTransitions>
            </VariableSizedWrapGrid>
        </ScrollViewer>

        <!-- Pagination -->
        <StackPanel x:Name="PaginationPanel" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="8" Margin="0,17.5,0,18.5" UseLayoutRounding="False"
                    Visibility="Collapsed">
            <Button x:Name="PrevPageButton" Content="&#xE76B;" FontFamily="Segoe Fluent Icons"
                    Click="PrevPage_Click" Width="36" Height="36" Padding="0"
                    Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="PageIndicator" VerticalAlignment="Center" Margin="0,0,0,2" FontSize="13" Opacity="0.8"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <Button x:Name="NextPageButton" Content="&#xE76C;" FontFamily="Segoe Fluent Icons"
                    Click="NextPage_Click" Width="36" Height="36" Padding="0"
                    Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </StackPanel>
    </Grid>
</Page>

