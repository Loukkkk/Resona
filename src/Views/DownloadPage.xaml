<Page
    NavigationCacheMode="Required"
    Background="Transparent"
    x:Class="Resona.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Resona.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Padding="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Titre -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24" Spacing="6">
            <TextBlock Text="{x:Bind models:Strings.Current.DownloadPage_Text_Tlchargerdelamusique, Mode=OneWay}" FontSize="28" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock FontSize="13" Opacity="0.6" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                <Run Text="{x:Bind models:Strings.Current.DownloadPage_DescText1, Mode=OneWay}" />
                <Run Text="{x:Bind models:Strings.Current.DownloadPage_Text_ytdlp, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="{x:Bind models:Strings.Current.DownloadPage_DescText2, Mode=OneWay}" />
                <Run Text="{x:Bind models:Strings.Current.DownloadPage_Text_ffmpeg, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="{x:Bind models:Strings.Current.DownloadPage_DescText3, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <!-- Formulaire -->
        <StackPanel Grid.Row="1" Spacing="16">

            <!-- Onglets URL / Recherche -->
            <StackPanel Spacing="8">
                <!-- Onglets style "pill" : même hauteur garantie, bordure partagée -->
                <Grid HorizontalAlignment="Left">
                    <Rectangle RadiusX="10" RadiusY="10" 
                               Fill="{StaticResource AppSurfaceBrush}"
                               Stroke="{StaticResource AppAccentBrush}"
                               StrokeThickness="1" />
                    <StackPanel Orientation="Horizontal" Spacing="2" Padding="3">
                        <Button x:Name="TabUrlButton" Click="TabUrl_Click"
                                Background="{StaticResource AppAccentBrush}" 
                                Foreground="{StaticResource AppAccentForegroundBrush}"
                                BorderThickness="0" CornerRadius="7" Padding="14,6"
                                MinHeight="0">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE71B;" FontSize="12" Foreground="{StaticResource AppAccentForegroundBrush}" />
                                <TextBlock Text="{x:Bind models:Strings.Current.DownloadPage_Text_URL, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppAccentForegroundBrush}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabSearchButton" Click="TabSearch_Click"
                                Background="Transparent" BorderThickness="0"
                                CornerRadius="7" Padding="14,6"
                                MinHeight="0" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind models:Strings.Current.DownloadPage_Text_RechercheYouTube, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Panneau URL (fixe, pas dynamique) -->
                <Grid x:Name="PanelUrl" ColumnSpacing="8" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="560" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBox"
                             PlaceholderText="{x:Bind models:Strings.Current.DownloadPage_Text_httpswwwyoutubecomwa, Mode=OneWay}"
                             FontFamily="Consolas" FontSize="13"
                             Grid.Column="0"
                             Foreground="{StaticResource TextBoxForegroundBrush}"
                             PlaceholderForeground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Button x:Name="PasteButton" Grid.Column="1"
                            Content="{x:Bind models:Strings.Current.DownloadPage_Content_Coller, Mode=OneWay}" Click="PasteButton_Click"
                            VerticalAlignment="Stretch" 
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                </Grid>

                <!-- Panneau Recherche YouTube -->
                <Grid x:Name="PanelSearch" Visibility="Collapsed" ColumnSpacing="8" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="560" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             PlaceholderText="{x:Bind models:Strings.Current.DownloadPage_Text_ArtisteTitreexDaftPu, Mode=OneWay}"
                             FontSize="13" Grid.Column="0"
                             KeyDown="SearchBox_KeyDown"
                             Foreground="{StaticResource TextBoxForegroundBrush}"
                             PlaceholderForeground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Button x:Name="SearchButton" Grid.Column="1"
                            Content="{x:Bind models:Strings.Current.DownloadPage_Content_Rechercher, Mode=OneWay}" Click="SearchButton_Click"
                            VerticalAlignment="Stretch" 
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                </Grid>

                <!-- Résultats de recherche -->
                <StackPanel x:Name="SearchResultsPanel" Visibility="Collapsed" Spacing="6" />
            </StackPanel>

            <!-- Boutons d'action -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="DownloadButton"
                        Click="DownloadButton_Click"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="20,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind models:Strings.Current.DownloadPage_Text_Tlcharger, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>
                <CheckBox x:Name="AutoTagCheckBox" VerticalAlignment="Center" IsChecked="True">
                    <TextBlock Text="{x:Bind models:Strings.Current.DownloadPage_Text_AppliquerAutotag, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </CheckBox>
            </StackPanel>

            <!-- Statut -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing x:Name="ProgressRing" IsActive="False" Width="20" Height="20" />
                <TextBlock x:Name="StatusText" FontSize="13" Opacity="0.8"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
        </StackPanel>

        <!-- Journal de sortie -->
        <Border Grid.Row="2" Margin="0,16,0,0" MaxWidth="720" HorizontalAlignment="Left"
                MaxHeight="260" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="LogBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         FontSize="11"
                         Opacity="0.65"
                         Background="Transparent"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         PlaceholderText="{x:Bind models:Strings.Current.DownloadPage_Text_Lasortiedeytdlpappar, Mode=OneWay}"
                         Foreground="{StaticResource TextBoxForegroundBrush}"
                         PlaceholderForeground="{ThemeResource TextFillColorTertiaryBrush}" />
            </ScrollViewer>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>



