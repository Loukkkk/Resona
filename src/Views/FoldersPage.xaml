<Page

    NavigationCacheMode="Required"

    Background="Transparent"

    x:Class="Resona.Views.FoldersPage"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Resona.Models">



    <Grid Padding="24">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>



        <!-- En-tête -->

        <Grid Grid.Row="0" Margin="0,0,0,16" VerticalAlignment="Center">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" UseLayoutRounding="False">

                <TextBlock Text="{x:Bind models:Strings.Current.FoldersPage_Text_Dossiers, Mode=OneWay}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"

                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <TextBlock x:Name="CountHint"  FontSize="14" VerticalAlignment="Center" Margin="0,8,0,0" Text=" "

                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            </StackPanel>

            <TextBox x:Name="SearchBox" Grid.Column="1"

                     PlaceholderText="{x:Bind models:Strings.Current.FoldersPage_Text_Rechercher, Mode=OneWay}" Width="220" MinHeight="28" Height="28" VerticalContentAlignment="Center" Padding="12,2,12,0"

                     TextChanged="SearchBox_TextChanged"

                     Foreground="{StaticResource TextBoxForegroundBrush}"

                     PlaceholderForeground="{ThemeResource TextFillColorTertiaryBrush}" />

        </Grid>



        <!-- Grille dossiers scrollable -->

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <VariableSizedWrapGrid x:Name="FoldersGrid"

                               Orientation="Horizontal"

                               HorizontalAlignment="Left"

                               MaximumRowsOrColumns="99"

                               ItemWidth="220"

                               ItemHeight="154"

                               Margin="0,0,0,24" />

        </ScrollViewer>



        <!-- Pagination -->

        <StackPanel x:Name="PaginationPanel" Grid.Row="2" Orientation="Horizontal"

                    HorizontalAlignment="Center" Spacing="8" Margin="0,20,0,0"

                    Visibility="Collapsed">

            <Button x:Name="PrevPageButton" Content="&#xE76B;" FontFamily="Segoe Fluent Icons"

                    Click="PrevPage_Click" Width="36" Height="36" Padding="0"

                    Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <TextBlock x:Name="PageIndicator" VerticalAlignment="Center" FontSize="13" Opacity="0.8"

                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <Button x:Name="NextPageButton" Content="&#xE76C;" FontFamily="Segoe Fluent Icons"

                    Click="NextPage_Click" Width="36" Height="36" Padding="0"

                    Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

        </StackPanel>

    </Grid>

</Page>








