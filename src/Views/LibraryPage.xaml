<Page
    NavigationCacheMode="Required"
    Background="Transparent"
    x:Class="Resona.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Resona.Models"
    xmlns:converters="using:Resona.Converters">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
        <converters:StringToImageBrushConverter x:Key="StringToImageBrushConverter" />
    </Page.Resources>

    <Grid Padding="24,44,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16" VerticalAlignment="Center" UseLayoutRounding="False">
            <Button x:Name="BackButton" Click="BackButton_Click" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0" CornerRadius="4" Width="40" Height="40">
                <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Button>
                        <StackPanel VerticalAlignment="Center" Spacing="2" UseLayoutRounding="False">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitleText" Text="{x:Bind models:Strings.Current.LibraryPage_Text_BIBLIOTHQUE, Mode=OneWay}" FontSize="28" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="TotalTracksHint" VerticalAlignment="Bottom" Margin="0,0,0,6" Text=" "
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="PageSubtitleText" Visibility="Collapsed" Opacity="0.6" FontSize="13"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBox x:Name="SearchBox" PlaceholderText="{x:Bind models:Strings.Current.LibraryPage_Text_RechercherdanslaBIBL, Mode=OneWay}"
                     Width="320" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"
                     Foreground="{StaticResource TextBoxForegroundBrush}"
                     PlaceholderForeground="{ThemeResource TextFillColorTertiaryBrush}"
                     Background="{ThemeResource ControlFillColorSecondaryBrush}"
                     BorderThickness="1"
                     BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />

            <Button VerticalAlignment="Center" Click="ShuffleAll_Click" ToolTipService.ToolTip="{x:Bind models:Strings.Current.LibraryPage_ToolTipService_ToolTip_LectureAlatoire, Mode=OneWay}" 
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8B1;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{x:Bind models:Strings.Current.LibraryPage_Text_Alatoire, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Button>

            <Button VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind models:Strings.Current.LibraryPage_ToolTipService_ToolTip_Trierlaliste, Mode=OneWay}" 
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="SortButtonLabel"  Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="{x:Bind models:Strings.Current.LibraryPage_Text_TitreAgtZ, Mode=OneWay}" Click="SortMenu_Click" Tag="title_asc" />
                        <MenuFlyoutItem Text="{x:Bind models:Strings.Current.LibraryPage_Text_ArtisteAgtZ, Mode=OneWay}" Click="SortMenu_Click" Tag="artist_asc" />
                        <MenuFlyoutItem Text="{x:Bind models:Strings.Current.LibraryPage_Text_AlbumAgtZ, Mode=OneWay}" Click="SortMenu_Click" Tag="album_asc" />
                        <MenuFlyoutItem Text="{x:Bind models:Strings.Current.LibraryPage_Text_Durecroissant, Mode=OneWay}" Click="SortMenu_Click" Tag="duration_asc" />
                        <MenuFlyoutItem Text="{x:Bind models:Strings.Current.LibraryPage_Text_Duredcroissant, Mode=OneWay}" Click="SortMenu_Click" Tag="duration_desc" />
                        <MenuFlyoutItem Text="{x:Bind models:Strings.Current.LibraryPage_Text_Ajoutrcentdabord, Mode=OneWay}" Click="SortMenu_Click" Tag="added_desc" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <ComboBox x:Name="DisplayLimitCombo" SelectionChanged="DisplayLimitCombo_SelectionChanged"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                      Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <ComboBoxItem Content="{x:Bind models:Strings.Current.LibraryPage_Content_50morceaux, Mode=OneWay}" Tag="50" />
                <ComboBoxItem Content="{x:Bind models:Strings.Current.LibraryPage_Content_100morceaux, Mode=OneWay}" Tag="100" />
                <ComboBoxItem Content="{x:Bind models:Strings.Current.LibraryPage_Content_300morceaux, Mode=OneWay}" Tag="300" />
                <ComboBoxItem Content="{x:Bind models:Strings.Current.LibraryPage_Content_500morceaux, Mode=OneWay}" Tag="500" />
                <ComboBoxItem Content="{x:Bind models:Strings.Current.LibraryPage_Content_1000morceaux, Mode=OneWay}" Tag="1000" />
                <ComboBoxItem Content="{x:Bind models:Strings.Current.LibraryPage_Content_2000morceaux, Mode=OneWay}" Tag="2000" />
                <ComboBoxItem Content="{x:Bind models:Strings.Current.LibraryPage_Content_Toutafficher, Mode=OneWay}" Tag="-1" />
            </ComboBox>
        </StackPanel>

        <ListView x:Name="TrackListView" Grid.Row="2"
                  ItemsSource="{x:Bind FilteredTracks, Mode=OneWay}"
                  DoubleTapped="TrackListView_DoubleTapped"
                  RightTapped="TrackListView_RightTapped"
                  SelectionChanged="TrackListView_SelectionChanged"
                  SelectionMode="Extended"
                  Padding="0,0,12,0"
                  ContainerContentChanging="TrackListView_ContainerContentChanging">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,1,0,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Grid x:Name="RootGrid" CornerRadius="8" Background="Transparent">
                                    <ContentPresenter
                                        x:Name="ContentPresenter"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Margin="0" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid x:Name="ItemRootGrid"
                          PointerEntered="TrackRow_PointerEntered" PointerExited="TrackRow_PointerExited" PointerPressed="TrackRow_PointerPressed">
                        <Border x:Name="PlayingBg" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" 
                                Opacity="{x:Bind OpacityPlayingBg, Mode=OneWay}" />
                        <Border x:Name="SelectionBg" Background="{StaticResource AppAccentBrush}" CornerRadius="8" Opacity="0" />
                        <Border x:Name="HoverBg"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                        <Rectangle x:Name="AccentBar" Width="4" RadiusX="2" RadiusY="2" Fill="{StaticResource AppAccentBrush}" 
                                   HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,14,0,14" 
                                   Opacity="{x:Bind OpacityPlaying, Mode=OneWay}" />
                        <Rectangle x:Name="HoverAccentBar" Width="4" RadiusX="2" RadiusY="2" Fill="{StaticResource AppAccentBrush}" 
                                   HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,14,0,14" 
                                   Opacity="0" />
                        <Grid Padding="12,4,16,4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="CoverGridContainer" Grid.Column="0" Width="40" Height="40" CornerRadius="5" Loaded="CoverGrid_Loaded"
                                  PointerEntered="CoverGrid_PointerEntered" PointerExited="CoverGrid_PointerExited">

                                <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                
                                <Border x:Name="CoverBorder" UseLayoutRounding="False" Width="40" Height="40"
                                        Background="{x:Bind CoverArtPath, Mode=OneWay, Converter={StaticResource StringToImageBrushConverter}}">
                                    <Border Background="#10FFFFFF" UseLayoutRounding="False" />
                                </Border>

                            <Border x:Name="SelectionOverlay" Background="{StaticResource AppAccentBrush}" Opacity="0" UseLayoutRounding="False">
                                <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="White" />
                            </Border>

                            <Border x:Name="NowPlayingIndicator" Background="#BB000000" Opacity="{x:Bind OpacityPlaying, Mode=OneWay}" UseLayoutRounding="False">
                                <StackPanel Orientation="Horizontal" Spacing="2"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border x:Name="Bar1" Width="3" Height="14" CornerRadius="1.5"
                                            Background="White" VerticalAlignment="Center">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="Bar1Scale" ScaleY="0.1" CenterY="14" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="Bar2" Width="3" Height="10" CornerRadius="1.5"
                                            Background="White" VerticalAlignment="Center">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="Bar2Scale" ScaleY="0.1" CenterY="10" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="Bar3" Width="3" Height="16" CornerRadius="1.5"
                                            Background="White" VerticalAlignment="Center">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="Bar3Scale" ScaleY="0.1" CenterY="16" />
                                        </Border.RenderTransform>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border x:Name="PlayOverlay" Background="#99000000" Visibility="Collapsed" UseLayoutRounding="False"
                                    Tapped="PlayOverlay_Tapped">
                                <FontIcon x:Name="OverlayIcon" Glyph="&#xE768;" Foreground="White" FontSize="16"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <HyperlinkButton Content="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold"
                                         Click="TrackTitle_Click" Tag="{x:Bind}" Padding="0" MinWidth="0" MinHeight="0"
                                         Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <HyperlinkButton Content="{x:Bind Artist, Mode=OneWay}" Click="Artist_Click" Tag="{x:Bind Artist, Mode=OneWay}" Opacity="0.7" FontSize="12"
                                         Foreground="{ThemeResource TextFillColorPrimaryBrush}" Padding="0" MinWidth="0" MinHeight="0" />
                        </StackPanel>

                        <HyperlinkButton Content="{x:Bind Album, Mode=OneWay}" Click="Album_Click" Tag="{x:Bind Album, Mode=OneWay}" Grid.Column="2" VerticalAlignment="Center" Opacity="0.8"
                                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" Padding="0" MinWidth="0" MinHeight="0" />
                        <TextBlock Text="{x:Bind DurationDisplay, Mode=OneWay}" Grid.Column="3" VerticalAlignment="Center"
                                   Opacity="0.6" TextAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="PaginationPanel" Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="8" Margin="0,20,0,0"
                    Visibility="Collapsed">
            <Button x:Name="PrevPageButton" Content="&#xE76B;" FontFamily="Segoe Fluent Icons"
                    Click="PrevPage_Click" Width="36" Height="36" Padding="0"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="PageIndicator" VerticalAlignment="Center" FontSize="13" Opacity="0.8"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <Button x:Name="NextPageButton" Content="&#xE76C;" FontFamily="Segoe Fluent Icons"
                    Click="NextPage_Click" Width="36" Height="36" Padding="0"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </StackPanel>
    </Grid>
</Page>












