<Page
    x:Class="Resona.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Resona.Models">

    <Grid Background="{StaticResource AppDeepBackgroundBrush}">

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" MaxWidth="480">

            <Ellipse x:Name="LogoCircle" Width="96" Height="96" Fill="{StaticResource AppAccentGradientBrush}"
                     HorizontalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="LogoScale" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <TextBlock x:Name="TitleText" Text="{x:Bind models:Strings.Current.OnboardingPage_Text_BienvenuedansAudioPl, Mode=OneWay}"
                       FontSize="28" FontWeight="Bold" TextAlignment="Center" Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TitleTranslate" />
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock x:Name="SubtitleText"
                       Text="{x:Bind models:Strings.Current.OnboardingPage_Text_Pourcommencerchoisis, Mode=OneWay}"
                       TextWrapping="Wrap" TextAlignment="Center" Opacity="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel x:Name="ActionPanel" Spacing="12" Opacity="0" HorizontalAlignment="Center">
                <Button Content="{x:Bind models:Strings.Current.OnboardingPage_Content_Choisirundossierdemu, Mode=OneWay}" HorizontalAlignment="Center"
                        Style="{ThemeResource AccentButtonStyle}" Padding="24,12"
                        Click="ChooseFolder_Click">
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="Black" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
                    </Button.Resources>
                </Button>
                <Button Content="{x:Bind models:Strings.Current.OnboardingPage_Content_Passercettetape, Mode=OneWay}" HorizontalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Click="Skip_Click" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>



