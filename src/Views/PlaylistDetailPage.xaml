<Page
    NavigationCacheMode="Disabled"
    Background="Transparent"
    x:Class="Resona.Views.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Resona.Models"
    xmlns:converters="using:Resona.Converters">

    <Page.Resources>
        <converters:StringToImageBrushConverter x:Key="StringToImageBrushConverter" />
    </Page.Resources>

    <Grid Padding="24,44,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20" ColumnSpacing="20" x:Name="HeaderGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Click="BackButton_Click" Visibility="Collapsed" VerticalAlignment="Center" CornerRadius="4" Width="40" Height="40">
                <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Button>
            <Border x:Name="HeaderCover" CornerRadius="10" Width="120" Height="120"
                    Background="{StaticResource AppSurfaceBrush}" Grid.Column="1" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="PlaylistName" FontSize="22" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" MaxLines="2"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="PlaylistCount" Opacity="0.5" FontSize="13"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <Button x:Name="PlayAllBtn"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Click="PlayAllBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind models:Strings.Current.PlaylistDetailPage_Text_Toutlire, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportBtn" Click="ExportBtn_Click"
                            Background="Transparent" BorderThickness="0"
                            Width="32" Height="32" Padding="0"
                            ToolTipService.ToolTip="{x:Bind models:Strings.Current.PlaylistDetailPage_ToolTipService_ToolTip_Exporterm3u8, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                        <FontIcon Glyph="&#xE898;" FontSize="14" />
                    </Button>
                    <Button x:Name="RenameBtn" Click="RenameBtn_Click"
                            Background="Transparent" BorderThickness="0"
                            Width="32" Height="32" Padding="0"
                            ToolTipService.ToolTip="{x:Bind models:Strings.Current.PlaylistDetailPage_ToolTipService_ToolTip_Renommer, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                    </Button>
                    <Button x:Name="DeleteBtn" Click="DeleteBtn_Click"
                            Background="Transparent" BorderThickness="0"
                            Width="32" Height="32" Padding="0"
                            ToolTipService.ToolTip="{x:Bind models:Strings.Current.PlaylistDetailPage_ToolTipService_ToolTip_Supprimer, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <ListView x:Name="TrackListView" Grid.Row="1"
                  ItemsSource="{x:Bind DisplayedTracks, Mode=OneWay}"
                  DoubleTapped="TrackListView_DoubleTapped"
                  RightTapped="TrackListView_RightTapped"
                  SelectionChanged="TrackListView_SelectionChanged"
                  SelectionMode="Extended"
                  Padding="0,0,12,0"
                  ContainerContentChanging="TrackListView_ContainerContentChanging">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,1,0,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Grid x:Name="RootGrid" CornerRadius="8" Background="Transparent">
                                    <ContentPresenter
                                        x:Name="ContentPresenter"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Margin="0" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid x:Name="ItemRootGrid"
                          PointerEntered="TrackRow_PointerEntered" PointerExited="TrackRow_PointerExited" PointerPressed="TrackRow_PointerPressed">
                        <Border x:Name="PlayingBg" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" 
                                Opacity="{x:Bind OpacityPlayingBg, Mode=OneWay}" />
                        <Border x:Name="SelectionBg" Background="{StaticResource AppAccentBrush}" CornerRadius="8" Opacity="0" />
                        <Border x:Name="HoverBg"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                        <Rectangle x:Name="AccentBar" Width="4" RadiusX="2" RadiusY="2" Fill="{StaticResource AppAccentBrush}" 
                                   HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,14,0,14" 
                                   Opacity="{x:Bind OpacityPlaying, Mode=OneWay}" />
                        <Rectangle x:Name="HoverAccentBar" Width="4" RadiusX="2" RadiusY="2" Fill="{StaticResource AppAccentBrush}" 
                                   HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,14,0,14" 
                                   Opacity="0" />
                        <Grid Padding="12,4,16,4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="40" Height="40" CornerRadius="5"
                                  PointerEntered="CoverGrid_PointerEntered" PointerExited="CoverGrid_PointerExited">
                                <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border x:Name="CoverBorder" Width="40" Height="40" Background="{x:Bind CoverArtPath, Mode=OneWay, Converter={StaticResource StringToImageBrushConverter}}">
                                    
                                    <Border Background="#10FFFFFF" />
                                </Border>
                                <Border x:Name="SelectionOverlay" Background="{StaticResource AppAccentBrush}" Opacity="0">
                                    <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="White" />
                                </Border>
                                <Border x:Name="NowPlayingIndicator" Background="#BB000000" Opacity="{x:Bind OpacityPlaying, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="2"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border x:Name="Bar1" Width="3" Height="14" CornerRadius="1.5"
                                                Background="White" VerticalAlignment="Bottom">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="Bar1Scale" ScaleY="0.1" CenterY="14" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="Bar2" Width="3" Height="10" CornerRadius="1.5"
                                                Background="White" VerticalAlignment="Bottom">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="Bar2Scale" ScaleY="0.1" CenterY="10" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="Bar3" Width="3" Height="16" CornerRadius="1.5"
                                                Background="White" VerticalAlignment="Bottom">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="Bar3Scale" ScaleY="0.1" CenterY="16" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PlayOverlay" Background="#99000000" Visibility="Collapsed"
                                        Tapped="PlayOverlay_Tapped">
                                    <FontIcon x:Name="OverlayIcon" Glyph="&#xE768;" Foreground="White" FontSize="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <HyperlinkButton Content="{x:Bind Title}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Click="TrackTitle_Click" Tag="{x:Bind}" Padding="0" MinWidth="0" MinHeight="0" />
                                <HyperlinkButton Content="{x:Bind Artist}" Click="Artist_Click" Tag="{x:Bind Artist}" Opacity="0.7" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" Padding="0" MinWidth="0" MinHeight="0" />
                            </StackPanel>
                            <HyperlinkButton Content="{x:Bind Album}" Click="Album_Click" Tag="{x:Bind Album}" Grid.Column="2" VerticalAlignment="Center" Opacity="0.8"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" Padding="0" MinWidth="0" MinHeight="0" />
                            <TextBlock Text="{x:Bind DurationDisplay, Mode=OneWay}" Grid.Column="3" VerticalAlignment="Center"
                                       Opacity="0.6" TextAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>






