<Page
    NavigationCacheMode="Required"
    Background="Transparent"
    x:Class="Resona.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Resona.Models"
    xmlns:converters="using:Resona.Converters">

    <Page.Resources>
        <converters:StringToImageBrushConverter x:Key="StringToImageBrushConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
    </Page.Resources>

    <Grid Padding="24,44,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Bind models:Strings.Current.PlaylistsPage_Text_Playlists, Mode=OneWay}" FontSize="28" FontWeight="Bold"
                   Grid.Row="0" Margin="0,0,160,16"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

        <StackPanel Spacing="12" Grid.Row="1" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="NewPlaylistButton" Click="NewPlaylist_Click" 
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind models:Strings.Current.PlaylistsPage_Text_Nouvelleplaylist, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ImportButton" Click="Import_Click" 
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind models:Strings.Current.PlaylistsPage_Text_Importerm3um3u8, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind models:Strings.Current.PlaylistsPage_ToolTipService_ToolTip_Trierlesplaylists, Mode=OneWay}"
                            BorderThickness="1" Height="32" Padding="12,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8CB;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="SortButtonLabel" Text="{x:Bind models:Strings.Current.PlaylistsPage_Text_TrierNom, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="{x:Bind models:Strings.Current.PlaylistsPage_Sort_Name, Mode=OneWay}" Click="SortPlaylistsMenu_Click" Tag="name" />
                                <MenuFlyoutItem Text="{x:Bind models:Strings.Current.LibraryPage_Sort_DateAdded, Mode=OneWay}" Click="SortPlaylistsMenu_Click" Tag="date" />
                                <MenuFlyoutItem Text="{x:Bind models:Strings.Current.PlaylistsPage_Sort_Count, Mode=OneWay}" Click="SortPlaylistsMenu_Click" Tag="count" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="SortDirectionIconBtn" Height="32" Width="32" Padding="0" Click="SortDirection_Click" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                        <FontIcon x:Name="SortDirectionIcon" Glyph="&#xE74B;" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="AIPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                <Button x:Name="AIGenerateBtn" Click="AIGenerateBtn_Click" 
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE904;" FontSize="14" />
                        <TextBlock Text="{x:Bind models:Strings.Current.PlaylistsPage_Text_Gnreruneplaylistavec, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">
                <GridView x:Name="PlaylistsGrid" SelectionMode="Extended" RightTapped="PlaylistsGrid_RightTapped" IsItemClickEnabled="True" ItemClick="PlaylistsGrid_ItemClick" SelectionChanged="PlaylistsGrid_SelectionChanged" Tapped="PlaylistsGrid_Tapped">
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                            <AddDeleteThemeTransition />
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,14,14"/>
                            <Setter Property="UseSystemFocusVisuals" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>

                <Border x:Name="DetailPanel" Visibility="Collapsed"
                        Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="10" Padding="0,0,0,8">
                    <StackPanel>
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                        <Grid Padding="16,14,16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Button x:Name="DetailCloseBtn" Click="DetailClose_Click"
                                        Background="Transparent" BorderThickness="0"
                                        Width="32" Height="32" Padding="0" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                    <FontIcon Glyph="&#xE76B;" FontSize="13" />
                                </Button>
                                <Border x:Name="DetailCoverBorder" Width="32" Height="32" CornerRadius="6"
                                        Background="{StaticResource AppAccentBrush}" VerticalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="DetailCoverImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                        <FontIcon x:Name="DetailCoverIcon" Glyph="&#xE00B;" FontSize="15"
                                                  Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="DetailCount" Opacity="0.5" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button x:Name="DetailPlayAllBtn" Click="DetailPlayAll_Click"
                                        Background="Transparent" BorderThickness="0"
                                        Width="32" Height="32" Padding="0"
                                        ToolTipService.ToolTip="{x:Bind models:Strings.Current.PlaylistsPage_ToolTipService_ToolTip_Toutlire, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                </Button>
                                <Button x:Name="DetailExportBtn" Click="DetailExport_Click"
                                        Background="Transparent" BorderThickness="0"
                                        Width="32" Height="32" Padding="0"
                                        ToolTipService.ToolTip="{x:Bind models:Strings.Current.PlaylistsPage_ToolTipService_ToolTip_Exporterm3u8, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                    <FontIcon Glyph="&#xE898;" FontSize="14" />
                                </Button>
                                <Button x:Name="DetailRenameBtn" Click="DetailRename_Click"
                                        Background="Transparent" BorderThickness="0"
                                        Width="32" Height="32" Padding="0"
                                        ToolTipService.ToolTip="{x:Bind models:Strings.Current.PlaylistsPage_ToolTipService_ToolTip_Renommer, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                </Button>
                                <Button x:Name="DetailDeleteBtn" Click="DetailDelete_Click"
                                        Background="Transparent" BorderThickness="0"
                                        Width="32" Height="32" Padding="0"
                                        ToolTipService.ToolTip="{x:Bind models:Strings.Current.PlaylistsPage_ToolTipService_ToolTip_Supprimer, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource AppAccentBrush}"
                                Opacity="0.15" Margin="0,0,0,4" />
                        <ListView x:Name="TrackListView"
                                  ItemsSource="{x:Bind DisplayedTracks, Mode=OneWay}"
                                  DoubleTapped="TrackListView_DoubleTapped"
                                  RightTapped="TrackListView_RightTapped"
                                  SelectionChanged="TrackListView_SelectionChanged"
                                  SelectionMode="Extended"
                                  Padding="0,0,12,0"
                                  ContainerContentChanging="TrackListView_ContainerContentChanging">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1,0,1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Grid x:Name="RootGrid" CornerRadius="8" Background="Transparent">
                                                    <ContentPresenter
                                                        x:Name="ContentPresenter"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                        Margin="0" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Grid x:Name="ItemRootGrid"
                                      PointerEntered="TrackRow_PointerEntered" PointerExited="TrackRow_PointerExited">
                                    <Border x:Name="PlayingBg" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" 
                                            Opacity="{x:Bind OpacityPlayingBg, Mode=OneWay}" />
                                    <Border x:Name="SelectionBg" Background="{StaticResource AppAccentBrush}" CornerRadius="8" Opacity="0" />
                                    <Border x:Name="HoverBg"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="8"
                                            Opacity="0" />
                                    <Rectangle x:Name="AccentBar" Width="4" RadiusX="2" RadiusY="2" Fill="{StaticResource AppAccentBrush}" 
                                               HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,14,0,14" 
                                               Opacity="{x:Bind OpacityPlaying, Mode=OneWay}" />
                                    <Rectangle x:Name="HoverAccentBar" Width="4" RadiusX="2" RadiusY="2" Fill="{StaticResource AppAccentBrush}" 
                                               HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,14,0,14" 
                                               Opacity="0" />
                                    <Grid Padding="12,4,16,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="40" Height="40" CornerRadius="5"
                                              PointerEntered="CoverGrid_PointerEntered" PointerExited="CoverGrid_PointerExited">
                                            <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border x:Name="CoverBorder" Width="40" Height="40" Background="{x:Bind CoverArtPath, Mode=OneWay, Converter={StaticResource StringToImageBrushConverter}}">
                                                
                                                <Border Background="#10FFFFFF" />
                                            </Border>
                                            <Border x:Name="SelectionOverlay" Background="{StaticResource AppAccentBrush}" Opacity="0">
                                                <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="White" />
                                            </Border>
                                            <Border x:Name="NowPlayingIndicator" Background="#BB000000" Opacity="{x:Bind OpacityPlaying, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="2"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border x:Name="Bar1" Width="3" Height="14" CornerRadius="1.5"
                                                            Background="White" VerticalAlignment="Bottom">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform x:Name="Bar1Scale" ScaleY="0.1" CenterY="14" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                    <Border x:Name="Bar2" Width="3" Height="10" CornerRadius="1.5"
                                                            Background="White" VerticalAlignment="Bottom">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform x:Name="Bar2Scale" ScaleY="0.1" CenterY="10" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                    <Border x:Name="Bar3" Width="3" Height="16" CornerRadius="1.5"
                                                            Background="White" VerticalAlignment="Bottom">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform x:Name="Bar3Scale" ScaleY="0.1" CenterY="16" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="PlayOverlay" Background="#99000000" Visibility="Collapsed"
                                                    Tapped="PlayOverlay_Tapped">
                                                <FontIcon x:Name="OverlayIcon" Glyph="&#xE768;" Foreground="White" FontSize="16"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <HyperlinkButton Content="{x:Bind Title}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Click="TrackTitle_Click" Tag="{x:Bind}" Padding="0" MinWidth="0" MinHeight="0" />
                                            <TextBlock Text="{x:Bind Artist}" Opacity="0.7" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Album}" Grid.Column="2" VerticalAlignment="Center" Opacity="0.8"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Button x:Name="FavoriteHeartBtn" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Background="Transparent" BorderThickness="0" Width="28" Height="28" Padding="0" Margin="6,0,0,0"
                                                Opacity="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}"
                                                Tag="{x:Bind}" Click="FavoriteHeartBtn_Click">
                                            <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="14"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Foreground="{StaticResource AppAccentBrush}" />
                                        </Button>
                                        <TextBlock Text="{x:Bind DurationDisplay, Mode=OneWay}" Grid.Column="4" VerticalAlignment="Center"
                                                   Opacity="0.6" TextAlignment="Right"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>







