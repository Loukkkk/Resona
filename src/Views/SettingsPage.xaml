<Page
    x:Class="Resona.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Resona.Models"
    Background="Transparent" NavigationCacheMode="Required">

    <ScrollViewer Padding="32,44,32,24" Background="Transparent">
        <StackPanel Spacing="28" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="{x:Bind models:Strings.Current.GlobalSettings, Mode=OneWay}" FontSize="32" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <!-- ===================== LANGUE / LANGUAGE ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsLanguageTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind models:Strings.Current.SettingsLanguageDesc, Mode=OneWay}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <DropDownButton x:Name="LanguageDropDown" MinHeight="32" Padding="12,0,12,0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="{x:Bind models:Strings.Current.SettingsPage_Content_Franaisfr, Mode=OneWay}" Tag="fr" Click="LanguageFlyoutItem_Click" />
                                        <MenuFlyoutItem Text="{x:Bind models:Strings.Current.SettingsPage_Content_Englishen, Mode=OneWay}" Tag="en" Click="LanguageFlyoutItem_Click" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ===================== FONCTIONNALITES ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Fonctionnalits, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <ToggleSwitch x:Name="NowPlayingSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Toggle_AutoNowPlaying, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="NowPlayingSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_AutoNowPlayingDesc, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="0,-12,0,0"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                        <ToggleSwitch x:Name="NormalizationSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_Normalisationduvolum, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="NormalizationSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Ajusteautomatiquemen, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                        <ToggleSwitch x:Name="LyricsSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_Boutonderecherchedes, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="LyricsSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_SiActivunboutonParol, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <Rectangle x:Name="TranslateLyricsSeparator" Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                        <ToggleSwitch x:Name="TranslateLyricsSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_Traductiondesparoles, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="TranslateLyricsSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}"
                                      >
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock x:Name="TranslateLyricsHintText" Text="{x:Bind models:Strings.Current.SettingsPage_Text_Traduitautomatiqueme, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                        <ToggleSwitch x:Name="CoverSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_Rechercheautomatique, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="CoverSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_RechercheautomatiqueDesc, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                        <ToggleSwitch x:Name="ExclusiveModeSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_Modeaudioexclusifqua, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="ExclusiveModeSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_DonneResonauna, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ===================== SYSTEME ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Systme, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <ToggleSwitch x:Name="MinimizeToTraySwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_Rduiredanslabarredes, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="MinimizeToTray_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Lapplicationserduitd, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                        <ToggleSwitch x:Name="StartWithWindowsSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_DmarreravecWindows, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="StartWithWindows_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>

                        <ToggleSwitch x:Name="StartMinimizedSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_Dmarrerdirectementen, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="StartMinimized_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock x:Name="StartMinimizedHint" Text="{x:Bind models:Strings.Current.SettingsPage_Text_NcessiteRduireenbarr, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ===================== EGALISEUR ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_galiseur, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <ToggleSwitch x:Name="EqualizerSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_Activerlgaliseur, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="EqualizerSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <StackPanel x:Name="EqualizerBandsPanel" Visibility="Collapsed" Spacing="8">
                            <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_AjustelegaindBdechaq, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <StackPanel x:Name="EqualizerPresetsContainer" Orientation="Vertical" Margin="0,0,0,8" Spacing="4" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="EqualizerSliders">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ===================== ASSISTANT PROMPT ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_AssistantPrompt, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <ToggleSwitch x:Name="AIEnabledSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_Activerleboutondelas, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="AIEnabledSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <Button x:Name="AIRestoreBackupBtn" Content="{x:Bind models:Strings.Current.SettingsPage_Content_Restaurerlesancienst, Mode=OneWay}" Click="AIRestoreBackupBtn_Click" Margin="0,0,0,0" Style="{StaticResource AccentButtonStyle}" />
                        
                        
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ===================== PLAYLISTS ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Playlists, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="{x:Bind models:Strings.Current.SettingsPage_Content_Importeruneplaylistm, Mode=OneWay}" Click="ImportPlaylist_Click" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Button Content="{x:Bind models:Strings.Current.SettingsPage_Content_Exporterlabibliothqu, Mode=OneWay}" Click="ExportPlaylist_Click" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ===================== BIBLIOTHEQUE ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Bibliothquemusicale, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <ListView x:Name="FoldersList" SelectionMode="None" MaxHeight="160" />
                        <Button Content="{x:Bind models:Strings.Current.SettingsPage_Content_Ajouterundossierdemu, Mode=OneWay}" Click="AddFolder_Click" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ===================== CATEGORIES AFFICHEES ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Catgoriesaffichesdan, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <CheckBox x:Name="ShowLibraryCheck"    Content="{x:Bind models:Strings.Current.SettingsPage_Content_Bibliothque, Mode=OneWay}"          Checked="CategoryCheck_Changed" Unchecked="CategoryCheck_Changed" Foreground="{StaticResource CheckBoxForegroundBrush}">
                            <CheckBox.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource CheckBoxForegroundBrush}" />
                                </DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
                        <CheckBox x:Name="ShowAlbumsCheck"     Content="{x:Bind models:Strings.Current.SettingsPage_Content_Albums, Mode=OneWay}"                Checked="CategoryCheck_Changed" Unchecked="CategoryCheck_Changed" Foreground="{StaticResource CheckBoxForegroundBrush}">
                            <CheckBox.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource CheckBoxForegroundBrush}" />
                                </DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
                        <CheckBox x:Name="ShowPlaylistsCheck"  Content="{x:Bind models:Strings.Current.SettingsPage_Content_Playlists, Mode=OneWay}"             Checked="CategoryCheck_Changed" Unchecked="CategoryCheck_Changed" Foreground="{StaticResource CheckBoxForegroundBrush}">
                            <CheckBox.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource CheckBoxForegroundBrush}" />
                                </DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
                        <CheckBox x:Name="ShowArtistsCheck"    Content="{x:Bind models:Strings.Current.SettingsPage_Content_Artistes, Mode=OneWay}"              Checked="CategoryCheck_Changed" Unchecked="CategoryCheck_Changed" Foreground="{StaticResource CheckBoxForegroundBrush}">
                            <CheckBox.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource CheckBoxForegroundBrush}" />
                                </DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
                        <CheckBox x:Name="ShowGenresCheck"     Content="{x:Bind models:Strings.Current.SettingsPage_Content_Genres, Mode=OneWay}"                Checked="CategoryCheck_Changed" Unchecked="CategoryCheck_Changed" Foreground="{StaticResource CheckBoxForegroundBrush}">
                            <CheckBox.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource CheckBoxForegroundBrush}" />
                                </DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
                        <CheckBox x:Name="ShowFoldersCheck"    Content="{x:Bind models:Strings.Current.SettingsPage_Content_Dossiers, Mode=OneWay}"              Checked="CategoryCheck_Changed" Unchecked="CategoryCheck_Changed" Foreground="{StaticResource CheckBoxForegroundBrush}">
                            <CheckBox.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource CheckBoxForegroundBrush}" />
                                </DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
                        <CheckBox x:Name="ShowStatisticsCheck" Content="{x:Bind models:Strings.Current.SettingsPage_Content_Statistiquesdcoute, Mode=OneWay}" Checked="CategoryCheck_Changed" Unchecked="CategoryCheck_Changed" Foreground="{StaticResource CheckBoxForegroundBrush}">
                            <CheckBox.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource CheckBoxForegroundBrush}" />
                                </DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
                        <CheckBox x:Name="ShowDownloadCheck"   Content="{x:Bind models:Strings.Current.SettingsPage_Content_Tlchargement, Mode=OneWay}"        Checked="CategoryCheck_Changed" Unchecked="CategoryCheck_Changed" Foreground="{StaticResource CheckBoxForegroundBrush}">
                            <CheckBox.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource CheckBoxForegroundBrush}" />
                                </DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ===================== TELECHARGEMENT ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Tlchargement, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">

                        <!-- Dossier de destination -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Dossierdedestination, Mode=OneWay}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DownloadFolderBox" IsReadOnly="True"
                                         PlaceholderText="{x:Bind models:Strings.Current.SettingsPage_Text_Dossierdetlchargemen, Mode=OneWay}"
                                         Grid.Column="0" FontSize="12"
                                         Foreground="{StaticResource TextBoxForegroundBrush}"
                                         PlaceholderForeground="{ThemeResource TextFillColorTertiaryBrush}"
                                         IsHitTestVisible="False" />
                                <Button Content="{x:Bind models:Strings.Current.SettingsPage_Content_Choisir, Mode=OneWay}" Grid.Column="1"
                                        Click="ChooseDownloadFolder_Click" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                        <!-- Format -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Formatdufichier, Mode=OneWay}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <ComboBox x:Name="DownloadFormatCombo"
                                      SelectionChanged="DownloadFormatCombo_Changed"
                                      MinWidth="200"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                <ComboBoxItem Content="{x:Bind models:Strings.Current.SettingsPage_Content_Opusrecommandmeilleu, Mode=OneWay}" Tag="Opus" />
                                <ComboBoxItem Content="{x:Bind models:Strings.Current.SettingsPage_Content_MP3compatibleunivers, Mode=OneWay}"                        Tag="Mp3" />
                                <ComboBoxItem Content="{x:Bind models:Strings.Current.SettingsPage_Content_FLACsanspertegrosfic, Mode=OneWay}"                 Tag="Flac" />
                                <ComboBoxItem Content="{x:Bind models:Strings.Current.SettingsPage_Content_M4AAAC, Mode=OneWay}"                                         Tag="M4a" />
                                <ComboBoxItem Content="{x:Bind models:Strings.Current.SettingsPage_Content_VorbisOGG, Mode=OneWay}"                                      Tag="Vorbis" />
                                <ComboBoxItem Content="{x:Bind models:Strings.Current.SettingsPage_Content_WAVnoncompress, Mode=OneWay}"                               Tag="Wav" />
                            </ComboBox>
                            <TextBlock x:Name="FormatHintText" FontSize="12" Opacity="0.6"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                        <!-- Codec -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Codecoptionnel, Mode=OneWay}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBox x:Name="DownloadCodecBox"
                                     PlaceholderText="{x:Bind models:Strings.Current.SettingsPage_Text_Laissvidecodecnatifd, Mode=OneWay}"
                                     TextChanged="DownloadCodecBox_Changed"
                                     FontFamily="Consolas" FontSize="13"
                                     Foreground="{StaticResource TextBoxForegroundBrush}"
                                     PlaceholderForeground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                                       Text="{x:Bind models:Strings.Current.SettingsPage_Text_Exempleslibopuslibmp, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                        <!-- qualite / debit -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_qualitdbitcible, Mode=OneWay}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <ComboBox x:Name="DownloadBitrateCombo"
                                      SelectionChanged="DownloadBitrateCombo_Changed"
                                      MinWidth="200"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                <ComboBoxItem Content="{x:Bind models:Strings.Current.SettingsPage_Content_Meilleurequalitsourc, Mode=OneWay}" Tag="Best" />
                                <ComboBoxItem Content="{x:Bind models:Strings.Current.SettingsPage_Content_320kbps, Mode=OneWay}"  Tag="Kbps320" />
                                <ComboBoxItem Content="{x:Bind models:Strings.Current.SettingsPage_Content_256kbps, Mode=OneWay}"  Tag="Kbps256" />
                                <ComboBoxItem Content="{x:Bind models:Strings.Current.SettingsPage_Content_192kbps, Mode=OneWay}"  Tag="Kbps192" />
                                <ComboBoxItem Content="{x:Bind models:Strings.Current.SettingsPage_Content_128kbps, Mode=OneWay}"  Tag="Kbps128" />
                            </ComboBox>
                            <TextBlock FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                                       Text="{x:Bind models:Strings.Current.SettingsPage_Text_Meilleurequalitsourc, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ===================== APPARENCE ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Apparence, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Styledefonddefentre, Mode=OneWay}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <RadioButtons x:Name="BackdropChoice" SelectionChanged="BackdropChoice_SelectionChanged" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                            <RadioButton Content="{x:Bind models:Strings.Current.SettingsPage_Content_Micarecommand, Mode=OneWay}" Tag="Mica" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <RadioButton Content="{x:Bind models:Strings.Current.SettingsPage_Content_MicaAltplussombre, Mode=OneWay}" Tag="MicaAlt" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <RadioButton Content="{x:Bind models:Strings.Current.SettingsPage_Content_Acryliceffetverredpo, Mode=OneWay}" Tag="Acrylic" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <RadioButton Content="{x:Bind models:Strings.Current.SettingsPage_Content_Couleurunie, Mode=OneWay}" Tag="Solid" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </RadioButtons>

                        <StackPanel x:Name="ColorPresetsPanel" Spacing="10" Visibility="Collapsed">
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />
                            <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Couleurduthme, Mode=OneWay}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <ItemsControl x:Name="PresetsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                            <ToggleSwitch x:Name="GradientOverflowSwitch"
                                          Header="{x:Bind models:Strings.Current.SettingsPage_Header_Dbordementdugradient, Mode=OneWay}"
                                          OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                          Toggled="GradientOverflowSwitch_Toggled"
                                          Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                                <ToggleSwitch.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                    </DataTemplate>
                                </ToggleSwitch.HeaderTemplate>
                            </ToggleSwitch>
                            <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Legradientdbordeaude, Mode=OneWay}"
                                       TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            
                <!-- Updates -->
                <StackPanel Margin="0,20,0,0" Spacing="16">
                    <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Updates, Mode=OneWay}"
                               FontSize="18" FontWeight="SemiBold" VerticalAlignment="Top"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <StackPanel  Spacing="20">
                        <StackPanel Spacing="8">
                            <ToggleSwitch x:Name="AutoUpdateSwitch" 
                                          Header="{x:Bind models:Strings.Current.SettingsPage_Text_AutoUpdate, Mode=OneWay}"
                                          OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}"
                                          OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                          Toggled="AutoUpdateSwitch_Toggled"
                                          Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                                <ToggleSwitch.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                    </DataTemplate>
                                </ToggleSwitch.HeaderTemplate>
                            </ToggleSwitch>
                            <Button x:Name="CheckUpdateButton" Content="{x:Bind models:Strings.Current.SettingsPage_Text_CheckUpdate, Mode=OneWay}"
                                    Click="CheckUpdateButton_Click" Margin="0,10,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
</StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>









