<Page
    x:Class="Resona.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Resona.Models"
    Background="Transparent" NavigationCacheMode="Required">

    <ScrollViewer Padding="24,44,32,0" Background="Transparent">
        <StackPanel x:Name="SettingsRoot" Spacing="28" MaxWidth="720" HorizontalAlignment="Left" Margin="8,0,0,24">

            <TextBlock Text="{x:Bind models:Strings.Current.GlobalSettings, Mode=OneWay}" FontSize="32" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <!-- ===================== LANGUE / LANGUAGE ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsLanguageTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind models:Strings.Current.SettingsLanguageDesc, Mode=OneWay}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <DropDownButton x:Name="LanguageDropDown" MinHeight="32" Padding="12,0,12,0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="{x:Bind models:Strings.Current.SettingsPage_Content_Franaisfr, Mode=OneWay}" Tag="fr" Click="LanguageFlyoutItem_Click" />
                                        <MenuFlyoutItem Text="{x:Bind models:Strings.Current.SettingsPage_Content_Englishen, Mode=OneWay}" Tag="en" Click="LanguageFlyoutItem_Click" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>


                        <!-- ===================== BOUTONS DU LECTEUR ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_PlayerButtons, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <ToggleSwitch x:Name="UpNextToggle" Toggled="UpNextToggle_Toggled" Header="{x:Bind models:Strings.Current.SettingsPage_Header_UpNextButton, Mode=OneWay}"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                          <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />


                        <ToggleSwitch x:Name="LyricsSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_LyricsButton, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="LyricsSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        
                        <ToggleSwitch x:Name="TranslateLyricsSwitch" Margin="24,0,0,0"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_Traductiondesparoles, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="TranslateLyricsSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock x:Name="TranslateLyricsHintText" Text="{x:Bind models:Strings.Current.SettingsPage_Text_Traduitautomatiqueme, Mode=OneWay}"
                                     TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="24,-12,0,0"
                                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                          <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />


                        <ToggleSwitch x:Name="ShowMiniPlayerSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_MiniPlayerButton, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="ShowMiniPlayerSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        
                        <ToggleSwitch x:Name="MiniPlayerAlwaysOnTopSwitch" Margin="24,0,0,0"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_MiniPlayerAlwaysOnTop, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="MiniPlayerAlwaysOnTopSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock x:Name="MiniPlayerAlwaysOnTopHintText" Text="{x:Bind models:Strings.Current.SettingsPage_Text_MiniPlayerAlwaysOnTopDesc, Mode=OneWay}"
                                     TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="24,-12,0,0"
                                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                          <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />


                        <ToggleSwitch x:Name="ShowFavoriteButtonSwitch"
                                      Header="{x:Bind models:Strings.Current.MainWindow_Tooltip_Favorites, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="ShowFavoriteButtonSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                          <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />


                        <ToggleSwitch x:Name="ShowEqualizerQuickButtonSwitch"
                                      Header="{x:Bind models:Strings.Current.MainWindow_Tooltip_Equalizer, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="ShowEqualizerQuickButtonSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>

                        

                    </StackPanel>
                </Grid>
            </StackPanel>

<!-- ===================== FONCTIONNALITES ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Fonctionnalits, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <ToggleSwitch x:Name="NowPlayingSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Toggle_AutoNowPlaying, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="NowPlayingSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_AutoNowPlayingDesc, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="0,-12,0,0"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                        <ToggleSwitch x:Name="NormalizationSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_Normalisationduvolum, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="NormalizationSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Ajusteautomatiquemen, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                        <ToggleSwitch x:Name="WeightedShuffleSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_WeightedShuffle, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="WeightedShuffleSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_WeightedShuffleDesc, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                        <ToggleSwitch x:Name="CoverSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_Rechercheautomatique, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="CoverSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_RechercheautomatiqueDesc, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                        <ToggleSwitch x:Name="DiscordRpcSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_EnableDiscord, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="DiscordRpcSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_DiscordDesc, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="0,-12,0,0"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                        <ToggleSwitch x:Name="ExclusiveModeSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_Modeaudioexclusifqua, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="ExclusiveModeSwitch_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_DonneResonauna, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ===================== SYSTEME ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Systme, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <ToggleSwitch x:Name="SaveWindowSizeSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_SaveWindowSize, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="SaveWindowSize_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <ToggleSwitch x:Name="SaveWindowPositionSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_SaveWindowPosition, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="SaveWindowPosition_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />
                        <ToggleSwitch x:Name="MinimizeToTraySwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_Rduiredanslabarredes, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="MinimizeToTray_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Lapplicationserduitd, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Margin="0,-12,0,10" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        


                        <ToggleSwitch x:Name="StartWithWindowsSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_DmarreravecWindows, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="StartWithWindows_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>

                        <ToggleSwitch x:Name="StartMinimizedSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_Dmarrerdirectementen, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="StartMinimized_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock x:Name="StartMinimizedHint" Text="{x:Bind models:Strings.Current.SettingsPage_Text_NcessiteRduireenbarr, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                        <!-- Integration a Windows : application par defaut pour les sons + menu "Ouvrir avec Resona" (textes definis dans SettingsPage.WindowsIntegration.cs) -->
                        <Button x:Name="DefaultAppsButton" Click="DefaultApps_Click"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="DefaultAppsHint" TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Margin="0,-8,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <ToggleSwitch x:Name="ExplorerMenuSwitch"
                                      Toggled="ExplorerMenu_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock x:Name="ExplorerMenuHint" TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ===================== BIBLIOTHEQUE ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Bibliothquemusicale, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <ListView x:Name="FoldersList" SelectionMode="None" MaxHeight="160" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind models:Strings.Current.SettingsPage_Content_Ajouterundossierdemu, Mode=OneWay}" Click="AddFolder_Click" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Button Content="{x:Bind models:Strings.Current.SettingsPage_Content_RescanFolders, Mode=OneWay}" Click="RescanFolders_Click" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,4" />
                        <ToggleSwitch x:Name="WatchFoldersSwitch"
                                      Header="{x:Bind models:Strings.Current.SettingsPage_Header_WatchFolders, Mode=OneWay}"
                                      OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}"
                                      OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                      Toggled="WatchFolders_Toggled"
                                      Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                        <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_WatchFoldersDesc, Mode=OneWay}"
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                   Margin="0,-8,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <!-- Controle qualite : sons sans cover, fichiers corrompus, tags incoherents... (voir SettingsPage.QualityCheck.cs) -->
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind models:Strings.Current.QualityCheck_Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind models:Strings.Current.QualityCheck_Desc, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.6" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center"
                                    Content="{x:Bind models:Strings.Current.QualityCheck_Button, Mode=OneWay}"
                                    Click="QualityCheck_Click" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ===================== CATEGORIES AFFICHEES ===================== -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Catgoriesaffichesdan, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <CheckBox x:Name="ShowLibraryCheck"    Content="{x:Bind models:Strings.Current.SettingsPage_Content_Bibliothque, Mode=OneWay}"          Checked="CategoryCheck_Changed" Unchecked="CategoryCheck_Changed" Foreground="{StaticResource CheckBoxForegroundBrush}">
                            <CheckBox.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource CheckBoxForegroundBrush}" />
                                </DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
                        <CheckBox x:Name="ShowAlbumsCheck"     Content="{x:Bind models:Strings.Current.SettingsPage_Content_Albums, Mode=OneWay}"                Checked="CategoryCheck_Changed" Unchecked="CategoryCheck_Changed" Foreground="{StaticResource CheckBoxForegroundBrush}">
                            <CheckBox.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource CheckBoxForegroundBrush}" />
                                </DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
                        <CheckBox x:Name="ShowPlaylistsCheck"  Content="{x:Bind models:Strings.Current.SettingsPage_Content_Playlists, Mode=OneWay}"             Checked="CategoryCheck_Changed" Unchecked="CategoryCheck_Changed" Foreground="{StaticResource CheckBoxForegroundBrush}">
                            <CheckBox.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource CheckBoxForegroundBrush}" />
                                </DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
                        <CheckBox x:Name="ShowArtistsCheck"    Content="{x:Bind models:Strings.Current.SettingsPage_Content_Artistes, Mode=OneWay}"              Checked="CategoryCheck_Changed" Unchecked="CategoryCheck_Changed" Foreground="{StaticResource CheckBoxForegroundBrush}">
                            <CheckBox.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource CheckBoxForegroundBrush}" />
                                </DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
                        <CheckBox x:Name="ShowGenresCheck"     Content="{x:Bind models:Strings.Current.SettingsPage_Content_Genres, Mode=OneWay}"                Checked="CategoryCheck_Changed" Unchecked="CategoryCheck_Changed" Foreground="{StaticResource CheckBoxForegroundBrush}">
                            <CheckBox.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource CheckBoxForegroundBrush}" />
                                </DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
