                            <ToggleSwitch x:Name="PlayerGradientSwitch"
                                          Header="{x:Bind models:Strings.Current.SettingsPage_Header_GradientDansLeLecteur, Mode=OneWay}"
                                          OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                          Toggled="PlayerGradientSwitch_Toggled"
                                          Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                                <ToggleSwitch.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                    </DataTemplate>
                                </ToggleSwitch.HeaderTemplate>
                            </ToggleSwitch>
                            <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_GradientDansLeLecteurDesc, Mode=OneWay}"
                                       TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                       Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                            <ToggleSwitch x:Name="NowPlayingEqualizerSwitch"
                                          Header="{x:Bind models:Strings.Current.SettingsPage_Header_NowPlayingEqualizer, Mode=OneWay}"
                                          OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                          Toggled="NowPlayingEqualizerSwitch_Toggled"
                                          Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                                <ToggleSwitch.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                    </DataTemplate>
                                </ToggleSwitch.HeaderTemplate>
                            </ToggleSwitch>
                            <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_NowPlayingEqualizerDesc, Mode=OneWay}"
                                       TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                       Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,-4" />

                            <ToggleSwitch x:Name="AudioReactiveThemeSwitch"
                                          Header="{x:Bind models:Strings.Current.SettingsPage_Header_AudioReactiveTheme, Mode=OneWay}"
                                          OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}" OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                          Toggled="AudioReactiveThemeSwitch_Toggled"
                                          Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                                <ToggleSwitch.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                    </DataTemplate>
                                </ToggleSwitch.HeaderTemplate>
                            </ToggleSwitch>
                            <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_AudioReactiveThemeDesc, Mode=OneWay}"
                                       TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                       Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Margin="0,20,0,0" Spacing="16">
                    <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_DataCache, Mode=OneWay}"
                               FontSize="18" FontWeight="SemiBold" VerticalAlignment="Top"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_ApplyMetadata, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_ApplyMetadataDesc, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.6" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Click="ApplyMetadata_Click" Content="{x:Bind models:Strings.Current.SettingsPage_Text_ApplyMetadataButton, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_ClearCache, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_ClearCacheDesc, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.6" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Click="ClearCache_Click" Content="{x:Bind models:Strings.Current.SettingsPage_Text_ClearCacheButton, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Grid>

                        <!-- Sauvegarde / Backup : import / export des reglages et de la bibliotheque -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Backup, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind models:Strings.Current.Backup_Desc, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.6" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="ExportBackupButton" Content="{x:Bind models:Strings.Current.Backup_ExportBtn, Mode=OneWay}"
                                            Click="ExportBackup_Click" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <Button x:Name="ImportBackupButton" Content="{x:Bind models:Strings.Current.Backup_ImportBtn, Mode=OneWay}"
                                            Click="ImportBackup_Click" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="BackupStatusText" TextWrapping="Wrap" FontSize="12" Opacity="0.8" Visibility="Collapsed"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                </StackPanel>
                
                <!-- Updates -->
                <StackPanel Margin="0,20,0,0" Spacing="16">
                    <TextBlock Text="{x:Bind models:Strings.Current.SettingsPage_Text_Updates, Mode=OneWay}"
                               FontSize="18" FontWeight="SemiBold" VerticalAlignment="Top"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="8">
                            <ToggleSwitch x:Name="AutoUpdateSwitch" 
                                          Header="{x:Bind models:Strings.Current.SettingsPage_Text_AutoUpdate, Mode=OneWay}"
                                          OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}"
                                          OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                          Toggled="AutoUpdateSwitch_Toggled"
                                          Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                                <ToggleSwitch.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                    </DataTemplate>
                                </ToggleSwitch.HeaderTemplate>
                            </ToggleSwitch>
                            <Button x:Name="CheckUpdateButton" Content="{x:Bind models:Strings.Current.SettingsPage_Text_CheckUpdate, Mode=OneWay}"
                                    Click="CheckUpdateButton_Click" Margin="0,10,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Button x:Name="WhatsNewButton" Content="{x:Bind models:Strings.Current.SettingsPage_Text_WhatsNew, Mode=OneWay}"
                                    Click="WhatsNewButton_Click" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                            <!-- Mise a jour de yt-dlp -->
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,12" />
                            <ToggleSwitch x:Name="YtDlpAutoUpdateSwitch"
                                          Header="{x:Bind models:Strings.Current.YtDlp_AutoUpdate, Mode=OneWay}"
                                          OnContent="{x:Bind models:Strings.Current.SettingsPage_Content_Activ, Mode=OneWay}"
                                          OffContent="{x:Bind models:Strings.Current.SettingsPage_Content_Dsactiv, Mode=OneWay}"
                                          Loaded="YtDlpAutoUpdateSwitch_Loaded"
                                          Toggled="YtDlpAutoUpdateSwitch_Toggled"
                                          Foreground="{StaticResource ToggleSwitchForegroundBrush}">
                                <ToggleSwitch.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ToggleSwitchForegroundBrush}" />
                                    </DataTemplate>
                                </ToggleSwitch.HeaderTemplate>
                            </ToggleSwitch>
                            <TextBlock Text="{x:Bind models:Strings.Current.YtDlp_AutoUpdateDesc, Mode=OneWay}"
                                       TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="0,-4,0,0"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="YtDlpVersionText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" Margin="0,6,0,0"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Button x:Name="YtDlpUpdateButton" Content="{x:Bind models:Strings.Current.YtDlp_UpdateNow, Mode=OneWay}"
                                    Click="YtDlpUpdateButton_Click" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="YtDlpStatusText" TextWrapping="Wrap" FontSize="12" Opacity="0.8" Visibility="Collapsed"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                </StackPanel>

</StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>










