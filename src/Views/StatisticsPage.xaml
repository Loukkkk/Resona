<Page
    NavigationCacheMode="Required"
    Background="Transparent"
    x:Class="Resona.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Resona.Models">

    <Grid Padding="24,44,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Bind models:Strings.Current.StatisticsPage_Text_Statistiques, Mode=OneWay}" FontSize="28" FontWeight="Bold"
                   Grid.Row="0" Margin="0,0,0,20"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" Spacing="8" Margin="0,0,0,24" />
        </ScrollViewer>
    </Grid>
</Page>



